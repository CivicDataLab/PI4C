# Copy to .env and fill in.


TELEGRAM_BOT_TOKEN=


# Webhook mode only: set this to any random string. Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header, and we reject requests that don't match.

TELEGRAM_WEBHOOK_SECRET=


# Anyone can read the API. Set this to true to also let anyone edit reports and view
# conversation logs, or false to turn both off for everyone.
WRITE_ACCESS=false


# Optional: path to the SQLite database file (SQLite is the only database supported for now).
# DATABASE_URL=sqlite:///data/other.db
