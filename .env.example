# Copy to .env and fill in.

# --- Telegram (active channel) ---
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Only needed in webhook mode: any random string; Telegram echoes it in a header we check.
TELEGRAM_WEBHOOK_SECRET=

# true = print/capture outbound messages instead of calling Telegram/WhatsApp.
DRY_RUN=false

# --- Classifier: OpenRouter Decisions API (blank key = keyword rules only) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.14

# --- Read API ---
# Comma-separated name:scope:key. scope is "read" or "write" (write implies read).
API_KEYS=dev:write:dev-key-change-me
# Web dashboards on other sites that call the API from the browser (comma-separated, or *):
# CORS_ORIGINS=https://dashboard.example.org

# Used to pseudonymise reporter chat IDs in reports.
REPORTER_HASH_SECRET=change-me

# Place search for typed place names. Blank key = public OpenStreetMap Nominatim (free, 1 search/s).
# Free LocationIQ key (no card): https://locationiq.com
LOCATIONIQ_API_KEY=
# Results are kept inside this box: lon_min,lat_min,lon_max,lat_max (default: Visakhapatnam, GVMC area)
# PLACE_SEARCH_BBOX=82.95,17.55,83.45,17.95

# Database. Blank = SQLite at data/pi4c.db. For Postgres (local or hosted: Neon, Supabase, Render...):
# DATABASE_URL=postgresql://user:password@localhost:5432/pi4c

# --- WhatsApp Cloud API (not active yet; kept for later) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=change-me
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
