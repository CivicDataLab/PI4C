# Copy to .env and fill in.

# --- Telegram (active channel) ---
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Only needed in webhook mode: any random string; Telegram echoes it in a header we check.
TELEGRAM_WEBHOOK_SECRET=

# --- Read API ---
# Comma-separated name:scope:key. scope is "read" or "write" (write implies read).
API_KEYS=dev:write:dev-key-change-me

# Place search for typed place names uses public OpenStreetMap Nominatim (free, no key, 1 search/s).

# Database: SQLite only for now. Blank = data/pi4c.db; set this to use another SQLite file.
# DATABASE_URL=sqlite:///data/other.db
